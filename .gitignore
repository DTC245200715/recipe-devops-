# Environment & Secrets
.env
.env.local
*.pem
*.key
!nginx/certs/selfsigned.key

# Runtime & Uploads (runtime data and user uploads are ignored, directory preserved via .gitkeep)
db/data/
app/public/uploads/*
!app/public/uploads/.gitkeep

# Temporary & Cache files
*.tmp
*.bak
*.old
*.swp
*~
~$*.docx
__pycache__/
*.py[cod]

# OS & Editor generated files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Build & Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
